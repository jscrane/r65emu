#!/bin/bash

KEEP_GOING=false
WRITE=false
TESTDIR=~/src/680x0/68000/v1
BRANCH=master

while getopts "kwt:b:" opt; do
	case "$opt" in
		k) KEEP_GOING=true;;
		t) TESTDIR="$OPTARG";;
		w) WRITE=true;;
		b) BRANCH="$OPTARG";;
		*) echo "Usage: $0 [-k] [-w] [-t test-dir] [-b diff-branch] [test-names...]"; exit 1;;
	esac
done

shift $((OPTIND - 1))

if [ $# -gt 0 ]; then
	TESTS="$*"
else
	TESTS="$(ls -1 ${TESTDIR} | grep "json.gz" | sed -e 's/.json.gz//')"
fi
SSTESTS=./sstests

for t in $TESTS; do
	TESTFILE=${TESTDIR}/$t.json.gz
	RESULTFILE=results/$t
	echo -n "$t: "
	if [ ${WRITE} ]; then
		${SSTESTS} ${TESTFILE} -k > ${RESULTFILE}
		git diff ${BRANCH}.. --numstat ${RESULTFILE} | awk '{add+=$1; del+=$2} END {printf "-%d +%d\n", del, add}'
	elif [ ! -f ${RESULTFILE} ]; then
		echo "SKIP"
	elif $(${SSTESTS} ${TESTFILE} -k | cmp -s - ${RESULTFILE}); then
		echo "PASS"
	else
		echo "FAIL"
		$KEEP_GOING || exit 1
	fi
done
